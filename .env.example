# ==============================================================================
# KLYPTRA Environment Configuration Example
# ==============================================================================

# Application Environment (development | production)
KLYPTRA_ENV=development

# Local backend port binding (Electron dynamically finds an open port if occupied)
KLYPTRA_PORT=8000

# Persistent user data storage path (default: %LOCALAPPDATA%\KLYPTRA on Windows)
# KLYPTRA_DATA_DIR=C:\Users\Username\AppData\Local\KLYPTRA

# Custom binary directory containing ffmpeg.exe and ffprobe.exe
# KLYPTRA_BIN_DIR=C:\ffmpeg\bin

# Python executable override for Electron development runner
# KLYPTRA_PYTHON=C:\Python314\python.exe

# Custom Whisper models storage directory
# KLYPTRA_MODELS_DIR=C:\AI_Models\whisper

# Internal per-session authorization token (automatically generated at startup in desktop mode)
# KLYPTRA_SESSION_TOKEN=

